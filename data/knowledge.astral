proto recv       extern SWORD recv(int4 socket, void *buffer, WORD length, int4 flags);
proto recvfrom   extern SWORD recvfrom(int4 socket, void *buffer, WORD length, int4 flags, void *address, uint4 *addressLength);
proto shutdown   extern int4 shutdown(int4 socket, int4 how);
proto setsockopt extern int4 setsockopt(int4 socket, int4 level, int4 option, void *value, uint4 valueLength);
proto getsockopt extern int4 getsockopt(int4 socket, int4 level, int4 option, void *value, uint4 *valueLength);
proto getpeername extern int4 getpeername(int4 socket, void *address, uint4 *addressLength);
proto getsockname extern int4 getsockname(int4 socket, void *address, uint4 *addressLength);
hdr socket sys/socket.h
hdr bind sys/socket.h
hdr listen sys/socket.h
hdr accept sys/socket.h
hdr connect sys/socket.h
hdr send sys/socket.h
hdr sendto sys/socket.h
