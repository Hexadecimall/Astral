# ============================================================ expanded surface
#
# A second, broader pass over the C library: the stdio print/scan variadics,
# the safe-string and BSD memory calls, more of stdlib/unistd, the time,
# signal, threading, memory-mapping and BSD-sockets/netdb interfaces. Each
# gets its declaring header and a prototype whose argument count and return
# type match the real macOS/POSIX declaration, so a call recovers exactly.

# ---- stdio: the variadic print/scan family and the odds and ends
proto vprintf    extern int4 vprintf(char *format, void *arguments);
proto vfprintf   extern int4 vfprintf(void *stream, char *format, void *arguments);
proto vsprintf   extern int4 vsprintf(char *buffer, char *format, void *arguments);
proto vsnprintf  extern int4 vsnprintf(char *buffer, WORD size, char *format, void *arguments);
proto vscanf     extern int4 vscanf(char *format, void *arguments);
proto vsscanf    extern int4 vsscanf(char *input, char *format, void *arguments);
proto vfscanf    extern int4 vfscanf(void *stream, char *format, void *arguments);
proto tmpnam     extern char *tmpnam(char *buffer);
proto ctermid    extern char *ctermid(char *buffer);
proto getline    extern SWORD getline(char **line, WORD *capacity, void *stream);
proto getdelim   extern SWORD getdelim(char **line, WORD *capacity, int4 delimiter, void *stream);
hdr vprintf stdio.h
hdr vsprintf stdio.h
hdr vscanf stdio.h
hdr vsscanf stdio.h
hdr vfscanf stdio.h
hdr tmpnam stdio.h
hdr ctermid stdio.h
hdr getline stdio.h
hdr getdelim stdio.h

