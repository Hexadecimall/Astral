proto strlcpy    extern WORD strlcpy(char *destination, char *source, WORD size);
proto strlcat    extern WORD strlcat(char *destination, char *source, WORD size);
proto bcopy      extern void bcopy(void *source, void *destination, WORD count);
proto bzero      extern void bzero(void *destination, WORD count);
