hdr getsockname sys/socket.h

# ---- netdb.h and arpa/inet.h
proto getaddrinfo  extern int4 getaddrinfo(char *host, char *service, void *hints, void **result);
proto freeaddrinfo extern void freeaddrinfo(void *info);
proto gethostbyname extern void *gethostbyname(char *name);
