proto inet_ntoa    extern char *inet_ntoa(uint4 address);
proto inet_pton    extern int4 inet_pton(int4 family, char *source, void *destination);
proto inet_ntop    extern char *inet_ntop(int4 family, void *source, char *destination, uint4 size);
proto htons        extern uint2 htons(uint2 value);
proto htonl        extern uint4 htonl(uint4 value);
proto ntohs        extern uint2 ntohs(uint2 value);
proto ntohl        extern uint4 ntohl(uint4 value);
hdr inet_addr arpa/inet.h
hdr inet_ntoa arpa/inet.h
hdr inet_pton arpa/inet.h
hdr inet_ntop arpa/inet.h
hdr htons arpa/inet.h
hdr htonl arpa/inet.h
hdr ntohs arpa/inet.h
hdr ntohl arpa/inet.h

# ------------------------------------------------- naming for the new surface
#
# Single-call verbs for functions the first pass did not cover.

verb chdir               changeDirectory
verb getuid              userId
verb geteuid             effectiveUserId
verb setuid              setUserId
verb getppid             parentProcessId
verb gethostname         hostName
verb fsync               syncFile
verb pread               readBytes
verb pwrite              writeBytes
verb sysctlbyname        readSystemControl
verb arc4random          randomNumber
verb arc4random_uniform  randomNumber
verb mkstemp             makeTempFile
verb tmpnam              makeTempName
verb ctermid             terminalName
verb posix_memalign      allocateAligned
verb aligned_alloc       allocateAligned
verb reallocf            resize
verb qsort_r             sortArray
verb getdelim            readDelimited
verb memmem              findSubsequence
verb strnlen             measureString
verb strlcat             appendString
verb bcopy               copyMemory
verb raise               raiseSignal
verb pthread_self        currentThread
verb pthread_setname_np  nameThread
verb pthread_get_stackaddr_np stackAddress
verb pthread_get_stacksize_np stackSize
verb setsockopt          configureSocket
verb getsockopt          readSocketOption
verb getpeername         peerAddress
verb getsockname         socketAddress
verb inet_pton           parseAddress
verb inet_ntop           formatAddress
verb inet_ntoa           formatAddress
verb inet_addr           parseAddress
verb htonl               hostToNetwork
verb ntohl               networkToHost
verb freeaddrinfo        releaseAddressInfo
verb gai_strerror        describeError
verb gethostbyname       resolveHost
verb vfprintf            printMessage
verb vprintf             printMessage
verb vsprintf            formatString

# Two calls together, checked before the single-call verbs.
idiom malloc+strcpy              duplicate
idiom pthread_mutex_lock+pthread_mutex_unlock  guardSection
idiom pthread_create+pthread_mutex_lock        runWorkers
idiom mmap+munmap                mapMemory
idiom open+fstat                 inspectFile
idiom sigaction+kill             manageSignals
idiom getaddrinfo+socket         openConnection
idiom socket+setsockopt          configureSocket
idiom getline+strtok             parseLines
idiom time+localtime             currentDateTime
idiom gettimeofday+localtime     currentDateTime
idiom fopen+getline              readFileLines

# What a function says about itself outranks the call-based rules.
lit connection refused|Connection refused   openConnection
lit no such file|No such file               openFile
lit invalid option|unrecognized option|invalid argument  printUsage
lit too many arguments|too few arguments    printUsage
lit assertion|Assertion failed              checkInvariant
lit warning:|Warning:                       reportWarning
lit fatal|Fatal error                       reportError
lit cannot open|could not open|unable to open  openFile
lit not a directory|Not a directory         openDirectory
lit disk full|No space left                 writeFile
hdr realpath stdlib.h
proto realpath extern char *realpath(char *path, char *resolved);
hdr malloc_type_malloc malloc/malloc.h
proto __stack_chk_fail extern void __stack_chk_fail(void);
proto __stack_chk_guard extern int8 __stack_chk_guard;
proto abort extern void abort(void);
proto main extern int4 main(int4 argc, char **argv);

# Functions that never come back. Decoding past a call to one of these runs
# into the next function in the image and merges the two.
noreturn abort
noreturn exit
noreturn _exit
noreturn _Exit
noreturn err
noreturn errx
noreturn verr
noreturn verrx
noreturn longjmp
noreturn siglongjmp
noreturn _longjmp
noreturn pthread_exit
noreturn __assert_rtn
noreturn __assert_fail
noreturn __chk_fail
noreturn abort_report_np
noreturn thread_exit
noreturn execl
noreturn execle
noreturn execlp
noreturn execv
noreturn execvp
noreturn execve
noreturn quick_exit
noreturn std::terminate
noreturn __cxa_throw
noreturn __cxa_rethrow
noreturn _Unwind_Resume
